rules_version = '2';

// Ported from the old supabase/schema.sql RLS policies. Admin status lives
// on profiles/{uid}.is_admin and is granted only by editing that doc in the
// Firebase console — no client path can set it.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // One profile read per evaluation — the Firestore analog of the SQL
    // "exists (select 1 from profiles where is_admin)" subquery.
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }

    // An admin's data is off-limits to the admin-purge path, so one admin
    // can never delete another's account or work. This is the REAL
    // enforcement of "admin accounts can't be removed" — the button being
    // disabled in the UI is only a courtesy.
    //
    // `&&` short-circuits, so a target with no profile doc costs one read
    // and is NOT protected: orphaned data (profile already gone) stays
    // cleanable rather than being permanently stranded.
    function targetIsProtected(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.is_admin == true;
    }

    // profiles: created client-side on first sign-in (the old
    // handle_new_user() trigger). Only last_seen_at may change afterwards.
    match /profiles/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.is_admin == false
        && request.resource.data.keys().hasOnly(['email', 'is_admin', 'created_at', 'last_seen_at', 'active_seconds']);
      // active_seconds is accumulated client-side and flushed with
      // increment() — see persistence/useActiveTime.ts. is_admin still
      // can't be self-granted; only these two fields may ever change.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_seen_at', 'active_seconds']);
      // Admin-only removal, and never another admin. Deleting a profile is
      // what makes an account "removed" in-app; the Firebase Auth login is
      // untouched (that needs the server-side Admin SDK).
      allow delete: if isAdmin() && resource.data.is_admin != true;
    }

    // projects: doc id == owner uid (one project per account).
    match /projects/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid) && request.resource.data.user_id == uid;
      allow delete: if isSelf(uid) || (isAdmin() && !targetIsProtected(uid));
    }

    // presets: flat collection scoped by user_id. Reads/lists require the
    // query to be provably limited to the caller's own rows.
    match /presets/{presetId} {
      // Admins can read (needed to enumerate a user's presets before a
      // purge) and delete, but never an admin's own rows.
      allow read: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if (signedIn() && resource.data.user_id == request.auth.uid)
        || (isAdmin() && !targetIsProtected(resource.data.user_id));
    }

    // feedback: users create + read their own threads; admins see and
    // manage everything. reply_count/last_reply_at are denormalized and
    // maintained by the admin's atomic reply batch (hence update: isAdmin).
    match /feedback/{feedbackId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reply_count == 0;
      allow update: if isAdmin();
      // Deleted only as part of an admin purge of the thread's author.
      allow delete: if isAdmin() && !targetIsProtected(resource.data.user_id);

      match /replies/{replyId} {
        allow read: if isAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/feedback/$(feedbackId)).data.user_id == request.auth.uid);
        allow create: if isAdmin() && request.resource.data.author_id == request.auth.uid;
        allow update: if false;
        // A reply carries the ADMIN's author_id, not the thread owner's, so
        // there's no target to protect here — the parent thread's own
        // delete rule is what gates whether this purge may happen at all.
        allow delete: if isAdmin();
      }
    }
  }
}
